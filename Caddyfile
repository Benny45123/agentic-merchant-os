# Caddyfile for Agentic Merchant OS
# Set DOMAIN in your .env (e.g., DOMAIN=amos.yourdomain.com) or leave as :80 for direct IP access

{$DOMAIN::80} {
    # Backend API routes
    handle /catalog* {
        reverse_proxy backend:8000
    }
    handle /commerce* {
        reverse_proxy backend:8000
    }
    handle /mandates* {
        reverse_proxy backend:8000
    }
    handle /receipts* {
        reverse_proxy backend:8000
    }
    handle /policy* {
        reverse_proxy backend:8000
    }
    handle /campaigns* {
        reverse_proxy backend:8000
    }
    handle /payments* {
        reverse_proxy backend:8000
    }
    handle /dashboard/api* {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }
    handle /.well-known* {
        reverse_proxy backend:8000
    }
    handle /docs* {
        reverse_proxy backend:8000
    }
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # All UI routes go to Next.js Frontend
    handle {
        reverse_proxy frontend:3000
    }
}
