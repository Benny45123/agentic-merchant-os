# ==============================================================================
# Agentic Merchant OS - Backend Environment Configuration
# ==============================================================================

# Database URL (SQLite with async aiosqlite for MVP)
DATABASE_URL=sqlite+aiosqlite:///./amos.db

# Razorpay Test-Mode Credentials (NEVER commit live keys, test mode only)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_never_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# LLM Provider Configuration (gemini | groq | openrouter)
LLM_PROVIDER=gemini
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Alternative LLM Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Security & Auth
JWT_SIGNING_KEY=change_this_to_a_secure_random_signing_key_for_jwt_session_tokens

# Environment Mode (local is only supported value for MVP)
ENV=local
